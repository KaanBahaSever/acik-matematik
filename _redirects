# Cloudflare Pages redirects (copied to _site/_redirects by scripts/build.py).
#
# The Analiz course used to be one book with its chapters under
# /dersler/analiz/1/ and /dersler/analiz/2/. It is now four books of its own,
# so the published addresses keep working from here.
/dersler/analiz/1/* /dersler/analiz-1/:splat 301
/dersler/analiz/2/* /dersler/analiz-2/:splat 301

# The downloadable files moved with their books; the whole-course file is gone,
# so it points at the page that lists the four books.
/dersler/analiz/analiz-1.pdf /dersler/analiz-1/analiz-1.pdf 301
/dersler/analiz/analiz-1.epub /dersler/analiz-1/analiz-1.epub 301
/dersler/analiz/analiz-2.pdf /dersler/analiz-2/analiz-2.pdf 301
/dersler/analiz/analiz-2.epub /dersler/analiz-2/analiz-2.epub 301
/dersler/analiz/analiz.pdf /dersler/analiz/ 301
/dersler/analiz/analiz.epub /dersler/analiz/ 301

# Soyut Cebir was one book with its chapters under /dersler/soyut-cebir/; it is
# now four books, and /dersler/soyut-cebir/ is the page that lists them.
/dersler/soyut-cebir/alt-gruplar/* /dersler/soyut-cebir-1/alt-gruplar/:splat 301
/dersler/soyut-cebir/bolum-gruplari/* /dersler/soyut-cebir-1/bolum-gruplari/:splat 301
/dersler/soyut-cebir/cebirsel-yapilar/* /dersler/soyut-cebir-1/cebirsel-yapilar/:splat 301
/dersler/soyut-cebir/devresel-gruplar/* /dersler/soyut-cebir-1/devresel-gruplar/:splat 301
/dersler/soyut-cebir/homomorfi/* /dersler/soyut-cebir-1/homomorfi/:splat 301
/dersler/soyut-cebir/kalan-siniflari/* /dersler/soyut-cebir-1/kalan-siniflari/:splat 301
/dersler/soyut-cebir/permutasyon-gruplari/* /dersler/soyut-cebir-1/permutasyon-gruplari/:splat 301
/dersler/soyut-cebir/cebir-1.pdf /dersler/soyut-cebir-1/soyut-cebir-1.pdf 301
/dersler/soyut-cebir/cebir-1.epub /dersler/soyut-cebir-1/soyut-cebir-1.epub 301
