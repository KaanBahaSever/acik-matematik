# Depoda satır sonları daima LF olarak saklanır; Windows'ta çalışırken
# çalışma kopyasına CRLF olarak açılır. CI (Ubuntu) ile yerel geliştirme
# arasında gereksiz fark oluşmasını engeller.
* text=auto eol=lf

# Kaynak ve yapılandırma dosyaları
*.qmd    text
*.md     text
*.yml    text
*.yaml   text
*.css    text
*.py     text eol=lf
*.sh     text eol=lf

# İkili dosyalar — dokunma
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary

# GitHub dil istatistiklerinde ders notları öne çıksın
*.qmd linguist-detectable=true
*.qmd linguist-language=Markdown
