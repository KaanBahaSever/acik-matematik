# Cloudflare Pages response headers (copied to _site/_headers by scripts/build.py).
#
# The site is served only over HTTPS, so browsers are told to use HTTPS for a
# year, on every subdomain as well.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Home page: point agents at the machine-readable maps of the site (RFC 8288).
/
  Link: </llms.txt>; rel="describedby"; type="text/markdown", </sitemap.xml>; rel="sitemap"; type="application/xml", </.well-known/agent-skills/index.json>; rel="agent-skills"; type="application/json"

# Markdown copies of the pages (scripts/agent_files.py) are for agents; search
# engines keep indexing the HTML pages.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/llms.txt
  Content-Type: text/markdown; charset=utf-8

/.well-known/agent-skills/*
  Access-Control-Allow-Origin: *
