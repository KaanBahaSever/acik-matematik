# ---------------------------------------------------------------
# Quarto build output
# ---------------------------------------------------------------
_site/
_book/
_freeze/
.quarto/
*.quarto_ipynb

# Single-file render output
/*_files/
**/*_files/
!**/assets/**

# ---------------------------------------------------------------
# Python (scripts/)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------
# Editor and operating-system leftovers
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Local environment / secrets
# ---------------------------------------------------------------
.env
.env.*
!.env.example
.dev.vars
.wrangler/

# ---------------------------------------------------------------
# Leftovers from the old VitePress setup (no longer used)
# ---------------------------------------------------------------
node_modules/
.vitepress/cache/
.vitepress/dist/

/.quarto/
**/*.quarto_ipynb
scripts/_figures/

# ---------------------------------------------------------------
# Downloadable files (regenerated by scripts/export.py on every deploy)
# ---------------------------------------------------------------
_export/
_export-src/
_export-figs/
_downloads.json

# Incremental build bookkeeping (scripts/build.py)
.build-cache.json

# ---------------------------------------------------------------
# Claude Code: per-session worktrees and personal settings.
# CLAUDE.md, .claude/rules, .claude/skills and .claude/agents are shared.
# ---------------------------------------------------------------
.claude/worktrees/
.claude/settings.local.json
CLAUDE.local.md
